# Copiar como frontend/.env.local (no se sube a git).

# URL de la API del backend, con el prefijo /api. En desarrollo el backend corre en el puerto 3000.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Tamaño máximo de cada PDF del formulario de preinscripción, en MB (opcional). Sin ella,
# el formulario no limita el tamaño y es el backend quien lo decide. Descomenta y pon un número
# cuando se confirme el límite real.
# NEXT_PUBLIC_TAMANO_MAXIMO_PDF_MB=
