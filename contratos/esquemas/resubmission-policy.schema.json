{
  "$id": "https://checku.iscoutb.dev/contratos/resubmission-policy.schema.json",
  "title": "ResubmissionPolicy",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "daily_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "used_today": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining_today": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timezone": {
      "type": "string",
      "const": "America/Bogota"
    },
    "local_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "next_available_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "daily_limit",
    "used_today",
    "remaining_today",
    "timezone",
    "local_date",
    "next_available_date"
  ],
  "additionalProperties": false
}
