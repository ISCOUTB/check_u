{
  "$id": "https://checku.iscoutb.dev/contratos/cross-validation-result.schema.json",
  "title": "CrossValidationResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rule": {
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "rule_version": {
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "sources": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "identification",
          "academic_evaluation",
          "paz_y_salvo_bib",
          "estampilla_pro_cultura",
          "saber_pro",
          "application_data",
          "banner",
          "rui"
        ]
      },
      "uniqueItems": true
    },
    "fields": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\S(?:.*\\S)?$"
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "confirmed_match",
        "confirmed_mismatch",
        "insufficient_information",
        "source_pending",
        "source_unavailable",
        "manual_review_required"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "identification",
              "academic_evaluation",
              "paz_y_salvo_bib",
              "estampilla_pro_cultura",
              "saber_pro",
              "application_data",
              "banner",
              "rui"
            ]
          },
          "field": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "normalized_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "field",
          "value",
          "normalized_value",
          "document_version"
        ],
        "additionalProperties": false
      }
    },
    "similarity": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "threshold": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "rule",
    "rule_version",
    "sources",
    "fields",
    "outcome",
    "evidence",
    "similarity",
    "threshold",
    "reason",
    "evaluated_at"
  ],
  "additionalProperties": false
}
