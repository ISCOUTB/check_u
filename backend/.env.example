# Copiar como backend/.env (no se sube a git). Sin .env el backend usa los valores por defecto.

# Puerto del backend. El frontend corre en el 3001 y llama a http://localhost:3000/api.
PORT=3000

# development | production. En production la cookie de sesión exige HTTPS.
NODE_ENV=development

# Observe (trazas y métricas de NestJS, https://observe.nestjs.com). Opcional:
# si falta alguna de las dos, el backend arranca sin Observe. Nunca subir las claves reales.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Variables locales de la base de datos. En producción se usan las variables de entorno del servidor.
DB_HOST=localhost
DB_PORT=5432
DB_USER=checku
# Contraseña de la base de datos (solo para entornos locales), no subir a Github. Definirla y luego ignorar el archivo backend/.env en .gitignore.
DB_PASSWORD=
DB_NAME=checku_local

SESSION_SECRET=

OCR_ENGINE_URL=http://localhost:8000
# URL del motor Python (Flask en modules/api)
MOTOR_URL=http://127.0.0.1:5001