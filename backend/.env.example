# Copiar como backend/.env (no se sube a git). Sin .env el backend usa los valores por defecto.

# Puerto del backend. El frontend corre en el 3001 y llama a http://localhost:3000/api.
PORT=3000

# development | production. En production la cookie de sesión exige HTTPS.
NODE_ENV=development

# Saltos de proxy de confianza para que el límite de frecuencia use la IP del cliente.
# En Dokploy (Traefik delante del backend) se deja 1. Usa 0 si el backend recibe las conexiones directas.
TRUST_PROXY=1

# Observe (trazas y métricas de NestJS, https://observe.nestjs.com). Opcional:
# si falta alguna de las dos, el backend arranca sin Observe. Nunca subir las claves reales.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Variables locales de la base de datos. En producción se usan las variables de entorno del servidor.
DB_HOST=localhost
DB_PORT=5432
DB_USER=checku
# Contraseña de la base de datos (solo para entornos locales), no subir a Github. Definirla y luego ignorar el archivo backend/.env en .gitignore.
DB_PASSWORD=
DB_NAME=checku_local

SESSION_SECRET=

OCR_ENGINE_URL=http://localhost:8000
# URL del motor Python (Flask en modules/api)
MOTOR_URL=http://127.0.0.1:5001

MOTOR_TIMEOUT_MS=60000

# Tarea 50: Paz y Salvo por consulta a Biblioteca (ALMA). Estas variables NO las lee el backend: las lee
# el motor Python (modules/validadores/fuentes/alma) cuando el backend le pide la consulta en MOTOR_URL.
# Defínelas en la terminal donde corres el motor, o en el .env de la raíz si usas docker-compose.local.yml.
# Sin el archivo de simulación, el Paz y Salvo queda «Por revisar».
# simulado (por defecto) lee el JSON de abajo; real usa ALMA_API_KEY y ALMA_BASE_URL.
ALMA_MODO=simulado
# Ruta al JSON de simulación, FUERA del repositorio. Parte de
# modules/validadores/fuentes/alma/alma_simulacion.example.json y llena el número de documento.
ALMA_SIMULACION_ARCHIVO=
# Solo con docker-compose.local.yml: carpeta del host que contiene alma_simulacion.json.
ALMA_SIMULACION_DIR=
# Solo con ALMA_MODO=real. Nunca subir la clave real.
ALMA_API_KEY=
ALMA_BASE_URL=

# PDF temporales fuera del repositorio. En producción, usar un volumen privado persistente.
# Si se omite, se usa el subdirectorio checku-documentos del temporal del sistema.
DOCUMENTOS_TEMP_DIR=

# Autenticación temporal de prueba (hasta Entra ID). No usar secretos reales en el ejemplo.
AUTH_ESTUDIANTE_USERNAME=estudiante@ejemplo.edu.co
AUTH_ESTUDIANTE_PASSWORD=cambiar-estudiante
AUTH_ESTUDIANTE_NAME=Estudiante de Prueba
AUTH_FUNCIONARIO_USERNAME=funcionario@ejemplo.edu.co
AUTH_FUNCIONARIO_PASSWORD=cambiar-funcionario
AUTH_FUNCIONARIO_NAME=Funcionario de Prueba
# Origen de la información del estudiante (nunca la contraseña, que siempre es AUTH_ESTUDIANTE_PASSWORD).
# ENV: usa AUTH_ESTUDIANTE_USERNAME y AUTH_ESTUDIANTE_NAME. DB: busca el correo en la tabla usuarios.
# En producción, usar DB. En desarrollo, se puede usar ENV para pruebas rápidas.
AUTH_INIT=ENV
